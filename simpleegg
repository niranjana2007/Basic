import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

// SCENE
const scene = new THREE.Scene();
scene.background = new THREE.Color("lightblue");

// CAMERA
const camera = new THREE.PerspectiveCamera(
    75, window.innerWidth / window.innerHeight, 0.1, 1000
);

camera.position.z = 10;

// RENDERER
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// BASKET
const basketGeometry = new THREE.BoxGeometry(2, 0.5, 1);
const basketMaterial = new THREE.MeshBasicMaterial({ color: "brown" });

const basket = new THREE.Mesh(basketGeometry, basketMaterial);
basket.position.y = -4;
scene.add(basket);

// EGG
const eggGeometry = new THREE.SphereGeometry(0.4, 32, 32);
const eggMaterial = new THREE.MeshBasicMaterial({ color: "white" });

let egg;

// GAME VARIABLES
let score = 0;
let lives = 3;
let gameRunning = false;

let left = false;
let right = false;

// CREATE EGG
function createEgg() {

    egg = new THREE.Mesh(eggGeometry, eggMaterial);

    egg.position.y = 5;
    egg.position.x = Math.random() * 12 - 6;

    scene.add(egg);
}

// KEYBOARD
document.addEventListener("keydown", function(event) {

    if (event.key === "ArrowLeft") left = true;
    if (event.key === "ArrowRight") right = true;

});

document.addEventListener("keyup", function(event) {

    if (event.key === "ArrowLeft") left = false;
    if (event.key === "ArrowRight") right = false;

});

// START GAME
window.startGame = function() {

    document.getElementById("startScreen").style.display = "none";
    document.getElementById("gameInfo").style.display = "block";

    score = 0;
    lives = 3;

    updateScore();
    updateLives();

    gameRunning = true;

    createEgg();
};

// RESTART
window.restartGame = function() {

    document.getElementById("endScreen").style.display = "none";

    startGame();
};

// UPDATE SCORE
function updateScore() {
    document.getElementById("score").innerText = "Score: " + score;
}

// UPDATE LIVES
function updateLives() {
    document.getElementById("lives").innerText = "Lives: " + lives;
}

// GAME OVER
function gameOver() {

    gameRunning = false;

    document.getElementById("gameInfo").style.display = "none";
    document.getElementById("endScreen").style.display = "block";

    document.getElementById("finalScore").innerText =
        "Your Score: " + score;
}

// ANIMATION
function animate() {

    requestAnimationFrame(animate);

    if (gameRunning) {

        // BASKET MOVEMENT
        if (left && basket.position.x > -7) {
            basket.position.x -= 0.1;
        }

        if (right && basket.position.x < 7) {
            basket.position.x += 0.1;
        }

        // EGG FALLING
        if (egg) {

            egg.position.y -= 0.05;

            // CATCH EGG
            if (
                egg.position.y < -3.5 &&
                Math.abs(egg.position.x - basket.position.x) < 1.3
            ) {

                scene.remove(egg);
                egg = null;

                score++;
                updateScore();

                createEgg();
            }

            // MISS EGG
            else if (egg.position.y < -5) {

                scene.remove(egg);
                egg = null;

                lives--;
                updateLives();

                if (lives === 0) {
                    gameOver();
                } else {
                    createEgg();
                }
            }
        }
    }

    renderer.render(scene, camera);
}

animate();

// WINDOW RESIZE
window.addEventListener("resize", function() {

    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();

    renderer.setSize(window.innerWidth, window.innerHeight);

});





<!DOCTYPE html>
<html>
<head>
    <title>Egg Catching Game</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div id="startScreen">
        <h1>Egg Catching Game</h1>
        <button onclick="startGame()">START GAME</button>
    </div>

    <div id="gameInfo">
        <h3 id="score">Score: 0</h3>
        <h3 id="lives">Lives: 3</h3>
    </div>

    <div id="endScreen">
        <h1>Game Over!</h1>
        <h2 id="finalScore">Your Score: 0</h2>
        <button onclick="restartGame()">RESTART</button>
    </div>

    <script type="module" src="main.js"></script>

</body>
</html>

body {
    margin: 0;
    overflow: hidden;
    font-family: Arial;
    background: lightblue;
}

#startScreen, #endScreen {
    position: absolute;
    top: 35%;
    width: 100%;
    text-align: center;
}

#endScreen {
    display: none;
}

button {
    padding: 12px 25px;
    font-size: 18px;
    cursor: pointer;
}

#gameInfo {
    position: absolute;
    top: 10px;
    left: 20px;
    display: none;
}


