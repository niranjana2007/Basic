
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);

const camera = new THREE.PerspectiveCamera(
    60,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
);
camera.position.set(0, 55, 105);


const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);


const loader = new THREE.TextureLoader();

async function loadTextures() {

    const names = [
        'sun',
        'mercury',
        'venus_surface',
        'earth_daymap',
        'mars',
        'jupiter',
        'saturn',
        'uranus',
        'neptune',
        'saturn_ring_alpha'
    ];

    const textures = await Promise.all(
        names.map(name => {
            const ext = name === 'saturn_ring_alpha' ? 'png' : 'jpg';

            return loader.loadAsync(
                `https://www.solarsystemscope.com/textures/download/2k_${name}.${ext}`
            );
        })
    );

    const textureMap = {};

    names.forEach((name, i) => {
        textureMap[name] = textures[i];
        textures[i].colorSpace = THREE.SRGBColorSpace;
    });

    return textureMap;
}


async function createSolarSystem() {

    const textures = await loadTextures();

  
    const sun = new THREE.Mesh(
        new THREE.SphereGeometry(2.5, 32, 32),
        new THREE.MeshBasicMaterial({
            map: textures.sun
        })
    );

    scene.add(sun);

    
    const planets = [
        { name: 'Mercury', size: 0.4, distance: 5, speed: 1.6, texture: textures.mercury },
        { name: 'Venus', size: 0.7, distance: 8, speed: 1.2, texture: textures.venus_surface },
        { name: 'Earth', size: 0.75, distance: 12, speed: 0.9, texture: textures.earth_daymap },
        { name: 'Mars', size: 0.55, distance: 16, speed: 0.7, texture: textures.mars },
        { name: 'Jupiter', size: 1.8, distance: 22, speed: 0.5, texture: textures.jupiter },
        { name: 'Saturn', size: 1.5, distance: 29, speed: 0.4, texture: textures.saturn },
        { name: 'Uranus', size: 1.0, distance: 36, speed: 0.3, texture: textures.uranus },
        { name: 'Neptune', size: 0.95, distance: 43, speed: 0.2, texture: textures.neptune }
    ];

    const movingPlanets = [];

    planets.forEach(p => {

      
        const group = new THREE.Group();
        scene.add(group);

        
        const planet = new THREE.Mesh(
            new THREE.SphereGeometry(p.size, 32, 32),
            new THREE.MeshBasicMaterial({
                map: p.texture
            })
        );

        planet.position.x = p.distance;
        group.add(planet);

      
        if (p.name === 'Saturn') {

            const ring = new THREE.Mesh(
                new THREE.RingGeometry(p.size * 1.4, p.size * 2.3, 64),
                new THREE.MeshBasicMaterial({
                    map: textures.saturn_ring_alpha,
                    transparent: true,
                    side: THREE.DoubleSide,
                    depthWrite: false
                })
            );

            ring.rotation.x = -Math.PI / 2;
            planet.add(ring);
        }

      
        const curve = new THREE.EllipseCurve(
            0, 0,
            p.distance,
            p.distance,
            0,
            2 * Math.PI
        );

        const points = curve.getPoints(100);

        const geometry = new THREE.BufferGeometry().setFromPoints(
            points.map(point =>
                new THREE.Vector3(point.x, 0, point.y)
            )
        );

        const orbit = new THREE.Line(
            geometry,
            new THREE.LineBasicMaterial({ color: 0x555555 })
        );

        scene.add(orbit);

      
        movingPlanets.push({
            group: group,
            mesh: planet,
            speed: p.speed
        });

    });

  
    function animate() {

        requestAnimationFrame(animate);

        sun.rotation.y += 0.002;

        movingPlanets.forEach(p => {

            // Revolution
            p.group.rotation.y += p.speed * 0.002;

            // Self rotation
            p.mesh.rotation.y += 0.01;
        });

        controls.update();
        renderer.render(scene, camera);
    }

    animate();
}

createSolarSystem();
